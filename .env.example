BRIEF_ENV=development
BRIEF_HOST=0.0.0.0
BRIEF_PORT=8000
BRIEF_PUBLIC_URL=http://localhost:8000

# Local stack: npm run db:up
BRIEF_DATABASE_URL=postgresql://brief:brief@localhost:5432/brief
BRIEF_REDIS_URL=redis://localhost:6379
BRIEF_GRAPH_CACHE_TTL_SECONDS=60

# MCP auth (enabled automatically when BRIEF_ENV=production)
# BRIEF_MCP_AUTH_ENABLED=true
# BRIEF_MCP_AUTH_DISABLED=true
# BRIEF_AUTH_ADMIN_SECRET=change-me
# BRIEF_MCP_STATIC_TOKENS=demo-user:brief_dev_token_demo
