BRIEF_ENV=development
BRIEF_HOST=0.0.0.0
BRIEF_PORT=8000
BRIEF_PUBLIC_URL=http://localhost:8000

# Local stack: npm run db:up
BRIEF_DATABASE_URL=postgresql://brief:brief@localhost:5432/brief
BRIEF_REDIS_URL=redis://localhost:6379
BRIEF_GRAPH_CACHE_TTL_SECONDS=60

# BRIEF_WEATHER_LATITUDE=35.7796
# BRIEF_WEATHER_LONGITUDE=-78.6382
# BRIEF_WEATHER_LOOKAHEAD_DAYS=7
# BRIEF_WEATHER_PRECIP_ALERT_THRESHOLD=50

# MCP auth (enabled automatically when BRIEF_ENV=production)
# BRIEF_MCP_AUTH_ENABLED=true
# BRIEF_MCP_AUTH_DISABLED=true
# BRIEF_AUTH_ADMIN_SECRET=change-me
# BRIEF_MCP_STATIC_TOKENS=demo-user:brief_dev_token_demo

# Google Calendar (optional — connector registers when set)
BRIEF_GOOGLE_CLIENT_ID=
BRIEF_GOOGLE_CLIENT_SECRET=
BRIEF_GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
BRIEF_GOOGLE_CALENDAR_LOOKAHEAD_DAYS=14
# Default scope: https://www.googleapis.com/auth/calendar.readonly
# BRIEF_GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar.readonly
