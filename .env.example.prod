# .env — production server config
#
# Use as documentation/reference for production runtime values.
# SECRETS (POSTGRES_PASSWORD, BRIEF_AUTH_ADMIN_SECRET, BRIEF_MCP_STATIC_TOKENS)
# are fetched from Infisical by deploy.sh and delivered as Docker secret files.
# They never appear in this file.
#
# Seed them first with: npm run bootstrap:secrets prod

# ── Server ───────────────────────────────────────────────────────────────────
BRIEF_ENV=production
BRIEF_HOST=0.0.0.0
BRIEF_PORT=8000
BRIEF_PUBLIC_URL=https://brief.yourdomain.com
BRIEF_GRAPH_CACHE_TTL_SECONDS=60
BRIEF_MCP_AUTH_DISABLED=false
BRIEF_ALLOWED_HOSTS=brief,brief:8000,brief.yourdomain.com
BRIEF_WEB_PORT=3100

# ── Optional local remote-ops helpers ────────────────────────────────────────
DROPLET_IP=
SSH_KEY_PATH=~/.ssh/id_ed25519
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_SITE_URL=https://app.infisical.com
SSH_KNOWN_HOSTS_FILE=

# ── Deploy image tags (set when running deploy.sh) ───────────────────────────
# BRIEF_IMAGE=brief-api:prod
# BRIEF_WEB_IMAGE=brief-web:prod
# BRIEF_IMAGE_ARCHIVE=/tmp/brief-api.tar.gz
# BRIEF_WEB_IMAGE_ARCHIVE=/tmp/brief-web.tar.gz
