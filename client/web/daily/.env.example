NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_DOCS_URL=http://localhost:3001
NEXT_PUBLIC_MCP_URL=http://localhost:3334/mcp

# App URL (OAuth redirect_uri base)
APP_URL=http://localhost:3000

# mcp-oauth-stack issuer (reference: MCP_PUBLIC_URL). Omit for local dev bypass.
# OAUTH_ISSUER=http://localhost:8001/oauth
# OAUTH_CLIENT_ID=briefs-daily
# OAUTH_CLIENT_SECRET=

# Session signing secret (use openssl rand -hex 32 in production)
SESSION_SECRET=dev-briefs-session-secret

# Dev bypass when OAUTH_ISSUER is unset (default in development)
# AUTH_DEV_BYPASS=true
DEV_USER_ID=demo
