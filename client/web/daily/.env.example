NEXT_PUBLIC_BRIEFS_API_URL=http://localhost:8001
NEXT_PUBLIC_BRIEFS_DOCS_URL=http://localhost:3001
NEXT_PUBLIC_BRIEFS_MCP_URL=http://localhost:3334/mcp

# App URL (OAuth redirect_uri base)
BRIEFS_APP_URL=http://localhost:3000

# mcp-oauth-stack issuer (reference: MCP_PUBLIC_URL). Omit for local dev bypass.
# BRIEFS_OAUTH_ISSUER=http://localhost:8001/oauth
# BRIEFS_OAUTH_CLIENT_ID=briefs-daily
# BRIEFS_OAUTH_CLIENT_SECRET=

# Session signing secret (use openssl rand -hex 32 in production)
BRIEFS_SESSION_SECRET=dev-briefs-session-secret

# Dev bypass when BRIEFS_OAUTH_ISSUER is unset (default in development)
# BRIEFS_AUTH_DEV_BYPASS=true
BRIEFS_DEV_USER_ID=demo
