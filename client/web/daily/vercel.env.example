# Set this to the deployed Daily URL so MCP tools can call the co-located API routes.
BRIEFS_API_URL=https://your-project.vercel.app
BRIEFS_DATABASE_URL=postgres://...
BRIEFS_AUTH_SECRET=replace-with-a-long-random-secret
BRIEFS_ENV=production
BRIEFS_OTP_MAILER=resend
BRIEFS_RESEND_API_KEY=re_...
BRIEFS_EMAIL_FROM=Briefs <briefs@example.com>
