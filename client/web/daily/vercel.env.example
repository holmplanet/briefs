# Set these to the deployed Daily URL so MCP tools can call the co-located API routes.
API_URL=https://your-project.vercel.app
DATABASE_URL=postgres://...
AUTH_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-a-different-long-random-secret
APP_ENV=production
APP_URL=https://your-project.vercel.app
OAUTH_ISSUER=https://your-project.vercel.app/oauth
OAUTH_CLIENT_ID=briefs-daily
OAUTH_REDIRECT_URIS=https://your-project.vercel.app/auth/callback
AUTH_ALLOWED_EMAILS=owner@example.com
OTP_MAILER=resend
RESEND_API_KEY=re_...
EMAIL_FROM=Briefs <briefs@example.com>
