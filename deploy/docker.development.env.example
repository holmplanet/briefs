# Local Docker Compose development.
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001
DAILY_PORT=3000
MCP_PORT=3334

DATABASE_URL=postgresql://briefs:briefs@postgres:5432/briefs
AUTH_SECRET=dev-briefs-auth-secret
SESSION_SECRET=dev-briefs-session-secret

OAUTH_ISSUER=http://localhost:8001/oauth
OAUTH_CLIENT_ID=briefs-daily
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URIS=http://localhost:3000/auth/callback

OTP_MAILER=console
RESEND_API_KEY=
EMAIL_FROM=
OTP_TTL_SECONDS=600

API_URL=http://system:8000
MCP_HEALTH_URL=http://mcp:3334/mcp
MCP_DEV_SKIP_AUTH=true
API_DEV_BYPASS=true
AUTH_DEV_BYPASS=true
DEV_USER_ID=demo
USER_ID=demo
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_MCP_URL=http://localhost:3334/mcp
