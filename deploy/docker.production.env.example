# Briefs Daily production runtime configuration.
# Copy to deploy/docker.production.env and replace the non-secret placeholders.
# Do not add DATABASE_URL, POSTGRES_PASSWORD, AUTH_SECRET, SESSION_SECRET, or
# RESEND_API_KEY here; deploy.sh supplies those from Infisical as Docker secrets.
APP_ENV=production
NODE_ENV=production
APP_DOMAIN=replace-with-obscure-hostname.holmplanet.com
APP_URL=https://replace-with-obscure-hostname.holmplanet.com

# Deploy-time image names are replaced with the current Git SHA by deploy.sh.
SYSTEM_IMAGE=briefs-system:replace-with-git-sha
MCP_IMAGE=briefs-mcp:replace-with-git-sha
DAILY_IMAGE=briefs-daily:replace-with-git-sha
RUNTIME_ENV_FILE=.env
SECRETS_DIR=./secrets

# Briefs System is the OAuth 2.1 issuer; Daily is a public PKCE client.
OAUTH_ISSUER=https://replace-with-obscure-hostname.holmplanet.com/oauth
OAUTH_CLIENT_ID=briefs-daily
OAUTH_REDIRECT_URIS=https://replace-with-obscure-hostname.holmplanet.com/auth/callback
# Exact remote-client callbacks allowed for dynamic OAuth registration.
# Add Claude's callback when using Claude Mobile; add other clients only by exact URI.
OAUTH_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback
# Use one address initially; add a second exact address later if needed.
AUTH_ALLOWED_EMAILS=replace-with-your-email@example.com

OTP_MAILER=resend
EMAIL_FROM="Briefs <replace-with-verified-sender@example.com>"
OTP_TTL_SECONDS=600

MCP_DEV_SKIP_AUTH=false
API_DEV_BYPASS=false
AUTH_DEV_BYPASS=false
NEXT_PUBLIC_API_URL=https://replace-with-obscure-hostname.holmplanet.com
NEXT_PUBLIC_MCP_URL=https://replace-with-obscure-hostname.holmplanet.com/mcp
NEXT_PUBLIC_DOCS_URL=https://briefs.holmplanet.com
