# Docker Compose production-shaped baseline. Replace every placeholder before use.
APP_ENV=production
NODE_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
DAILY_PORT=3000
MCP_PORT=3334
APP_DOMAIN=briefs.example.com
APP_URL=https://briefs.example.com
SYSTEM_IMAGE=briefs-system:replace-with-git-sha
MCP_IMAGE=briefs-mcp:replace-with-git-sha
DAILY_IMAGE=briefs-daily:replace-with-git-sha
RUNTIME_ENV_FILE=.env
SECRETS_DIR=./secrets

OAUTH_ISSUER=https://briefs.example.com/oauth
OAUTH_CLIENT_ID=briefs-daily
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URIS=https://briefs.example.com/auth/callback
AUTH_ALLOWED_EMAILS=owner@example.com

OTP_MAILER=resend
EMAIL_FROM="Briefs <no-reply@example.com>"
OTP_TTL_SECONDS=600

API_URL=http://system:8000
MCP_HEALTH_URL=http://mcp:3334/mcp
MCP_DEV_SKIP_AUTH=false
API_DEV_BYPASS=false
AUTH_DEV_BYPASS=false
DEV_USER_ID=demo
USER_ID=demo
NEXT_PUBLIC_API_URL=https://briefs.example.com
NEXT_PUBLIC_MCP_URL=https://briefs.example.com/mcp
