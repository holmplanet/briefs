# Protected Preview deployment. Use a separate database and secrets from Production.
APP_ENV=development
APP_URL=https://your-preview-project.vercel.app
API_URL=https://your-preview-project.vercel.app
NEXT_PUBLIC_API_URL=https://your-preview-project.vercel.app

DATABASE_URL=postgres://preview-user:replace-me@preview-host/briefs
AUTH_SECRET=replace-with-a-preview-only-secret
SESSION_SECRET=replace-with-a-preview-only-secret

OAUTH_ISSUER=https://your-preview-project.vercel.app/oauth
OAUTH_CLIENT_ID=briefs-daily
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URIS=https://your-preview-project.vercel.app/auth/callback
AUTH_ALLOWED_EMAILS=owner@example.com

OTP_MAILER=resend
RESEND_API_KEY=re_replace_me
EMAIL_FROM=Briefs <preview@example.com>
OTP_TTL_SECONDS=600

API_DEV_BYPASS=false
AUTH_DEV_BYPASS=false
MCP_DEV_SKIP_AUTH=false
