# Vercel Production baseline. Use production-only secrets, database, and verified email sender.
APP_ENV=production
APP_URL=https://briefs.example.com
API_URL=https://briefs.example.com
NEXT_PUBLIC_API_URL=https://briefs.example.com

DATABASE_URL=postgres://production-user:replace-me@production-host/briefs
AUTH_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-a-different-long-random-secret

OAUTH_ISSUER=https://briefs.example.com/oauth
OAUTH_CLIENT_ID=briefs-daily
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URIS=https://briefs.example.com/auth/callback

OTP_MAILER=resend
RESEND_API_KEY=re_replace_me
EMAIL_FROM=Briefs <no-reply@example.com>
OTP_TTL_SECONDS=600

API_DEV_BYPASS=false
AUTH_DEV_BYPASS=false
MCP_DEV_SKIP_AUTH=false
