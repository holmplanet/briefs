APP_ENV=production
NODE_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
MCP_PORT=3334
DAILY_PORT=3000
APP_URL=https://briefs.example.com
OAUTH_ISSUER=https://briefs.example.com/oauth
