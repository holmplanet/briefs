BRIEFS_ENV=production
NODE_ENV=production
BRIEFS_HOST=0.0.0.0
BRIEFS_PORT=8000
BRIEFS_MCP_PORT=3334
BRIEFS_DAILY_PORT=3000
BRIEFS_APP_URL=https://briefs.example.com
BRIEFS_OAUTH_ISSUER=https://briefs.example.com/oauth
BRIEFS_OAUTH_CLIENT_ID=briefs-daily
BRIEFS_OAUTH_REDIRECT_URIS=https://briefs.example.com/auth/callback
BRIEFS_OTP_MAILER=resend
BRIEFS_EMAIL_FROM=Briefs <no-reply@example.com>
BRIEFS_MCP_DEV_SKIP_AUTH=false
BRIEFS_API_DEV_BYPASS=false
BRIEFS_AUTH_DEV_BYPASS=false
BRIEFS_SYSTEM_IMAGE=ghcr.io/holmplanet/briefs-system:latest
BRIEFS_MCP_IMAGE=ghcr.io/holmplanet/briefs-mcp:latest
BRIEFS_DAILY_IMAGE=ghcr.io/holmplanet/briefs-daily:latest
