FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS deps

WORKDIR /repo

COPY package.json package-lock.json tsconfig.base.json ./
COPY shared/package.json shared/tsconfig.json shared/
COPY system/package.json system/tsconfig.json system/
COPY client/mcp/package.json client/mcp/tsconfig.json client/mcp/
COPY client/web/shared/package.json client/web/shared/tsconfig.json client/web/shared/
COPY client/web/daily/package.json client/web/daily/tsconfig.json client/web/daily/

RUN npm ci -w @briefs/daily -w @briefs/web-shared -w @briefs/system -w @briefs/mcp -w @briefs/shared --include-workspace-root

FROM deps AS build

ARG NEXT_PUBLIC_API_URL=http://system:8000
ARG NEXT_PUBLIC_MCP_URL=http://localhost:3334/mcp
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_MCP_URL=$NEXT_PUBLIC_MCP_URL

COPY shared/src shared/src
COPY system/src system/src
COPY client/mcp/src client/mcp/src
COPY client/web/shared/src client/web/shared/src
COPY client/web/daily/src client/web/daily/src
COPY client/web/daily/public client/web/daily/public
COPY client/web/daily/next.config.ts client/web/daily/
COPY client/web/daily/postcss.config.mjs client/web/daily/
COPY client/web/daily/components.json client/web/daily/
RUN npm run build -w @briefs/shared \
  && npm run build -w @briefs/system \
  && npm run build -w @briefs/mcp \
  && npm run build -w @briefs/daily

FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS runtime

WORKDIR /repo

COPY --from=deps /repo/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY shared/package.json shared/
COPY --from=build /repo/shared/dist shared/dist
COPY client/web/shared/package.json client/web/shared/
COPY --from=build /repo/client/web/shared/src client/web/shared/src
COPY db db
COPY client/web/daily/package.json client/web/daily/
COPY --from=build /repo/client/web/daily/public client/web/daily/public
COPY --from=build /repo/client/web/daily/.next client/web/daily/.next
COPY --from=build /repo/client/web/daily/next.config.ts client/web/daily/
COPY docker/entrypoint-secrets.sh /usr/local/bin/briefs-entrypoint
RUN chmod 755 /usr/local/bin/briefs-entrypoint

USER node

ENV NODE_ENV=production
ENV PORT=3000
ENV NEXT_PUBLIC_API_URL=http://system:8000
ENV NEXT_PUBLIC_MCP_URL=http://localhost:3334/mcp

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/usr/local/bin/briefs-entrypoint"]
CMD ["npm", "run", "start", "-w", "@briefs/daily"]
