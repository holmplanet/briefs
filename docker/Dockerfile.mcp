FROM node:26-alpine@sha256:2d984a15c9b54fd0aeb608b8e0d0d83529eb34d2966db27a1fb4f1edc3d298a3 AS deps

WORKDIR /repo

COPY package.json package-lock.json tsconfig.base.json ./
COPY shared/package.json shared/tsconfig.json shared/
COPY client/mcp/package.json client/mcp/tsconfig.json client/mcp/

RUN npm ci -w @briefs/mcp -w @briefs/shared --include-workspace-root

FROM deps AS build

COPY shared/src shared/src
COPY client/mcp/src client/mcp/src

RUN npm run build -w @briefs/shared \
  && npm run build -w @briefs/mcp

FROM node:26-alpine@sha256:2d984a15c9b54fd0aeb608b8e0d0d83529eb34d2966db27a1fb4f1edc3d298a3 AS runtime

WORKDIR /repo

COPY --from=deps /repo/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY shared/package.json shared/
COPY --from=build /repo/shared/dist shared/dist
COPY client/mcp/package.json client/mcp/
COPY --from=build /repo/client/mcp/dist client/mcp/dist
COPY docker/entrypoint-secrets.sh /usr/local/bin/briefs-entrypoint
RUN chmod 755 /usr/local/bin/briefs-entrypoint

USER node

ENV NODE_ENV=production
ENV MCP_PORT=3334
ENV API_URL=http://system:8000

EXPOSE 3334

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3334/health').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/usr/local/bin/briefs-entrypoint"]
CMD ["node", "client/mcp/dist/standalone.js"]
