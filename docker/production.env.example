BRIEFS_ENV=production
NODE_ENV=production

# Public origins and OAuth registration
BRIEFS_APP_URL=https://briefs.example.com
BRIEFS_OAUTH_ISSUER=https://briefs.example.com/oauth
BRIEFS_OAUTH_CLIENT_ID=briefs-daily
BRIEFS_OAUTH_CLIENT_SECRET=
BRIEFS_OAUTH_REDIRECT_URIS=https://briefs.example.com/auth/callback
NEXT_PUBLIC_BRIEFS_API_URL=https://briefs.example.com
NEXT_PUBLIC_BRIEFS_MCP_URL=https://briefs.example.com/mcp

# Required secrets and durable storage
BRIEFS_AUTH_SECRET=replace-with-a-long-random-secret
BRIEFS_SESSION_SECRET=replace-with-a-different-long-random-secret
BRIEFS_DATABASE_URL=postgresql://briefs:replace-me@postgres:5432/briefs

# Required production email delivery
BRIEFS_OTP_MAILER=resend
BRIEFS_RESEND_API_KEY=re_replace_me
BRIEFS_EMAIL_FROM=Briefs <no-reply@example.com>

# Production must not use development bypasses
BRIEFS_API_DEV_BYPASS=false
BRIEFS_MCP_DEV_SKIP_AUTH=false
BRIEFS_AUTH_DEV_BYPASS=false
