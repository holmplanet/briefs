{
  "name": "brief",
  "private": true,
  "version": "0.3.0",
  "description": "Holmplanet Brief — schema-first task platform",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "system",
    "client/personal",
    "client/livestock",
    "client/fishing"
  ],
  "scripts": {
    "dev": "npm run dev:system",
    "dev:system": "npm run dev -w @brief/system",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @brief/system",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f system"
  }
}
