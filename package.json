{
  "name": "holmplanet-brief",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Holmplanet Brief — AI coordination platform",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:smoke": "vitest run tests/smoke",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dogfood": "tsx scripts/dogfood.ts",
    "dogfood:tasks": "tsx scripts/try-tasks.ts",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "docker:build": "docker compose build brief web",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f brief web",
    "dev:web": "npm run dev --prefix web",
    "build:web": "npm run build --prefix web",
    "typecheck:web": "npm run typecheck --prefix web"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "pg": "^8.16.3",
    "redis": "^5.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
