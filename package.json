{
  "name": "briefs",
  "private": true,
  "version": "0.3.0",
  "description": "Holmplanet Briefs — items, actors, and activities",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "system",
    "client/web/shared",
    "client/web/docs",
    "client/web/daily",
    "client/agent",
    "client/cli",
    "client/mcp"
  ],
  "scripts": {
    "dev": "npm run dev:system",
    "dev:system": "npm run dev -w @briefs/system",
    "dev:docs": "npm run dev -w @briefs/docs",
    "dev:daily": "npm run dev -w @briefs/daily",
    "dev:mcp": "npm run dev -w @briefs/mcp",
    "dev:agent": "npm run dev -w @briefs/agent",
    "briefs": "npm run briefs -w @briefs/cli --",
    "example:rest": "node examples/create-and-read-item.mjs",
    "briefs:smoke": "npm run briefs -w @briefs/cli -- smoke",
    "briefs:e2e-smoke": "npm run e2e:smoke -w @briefs/mcp",
    "build": "npm run build -w @briefs/shared && npm run build -w @briefs/system && npm run build -w @briefs/mcp && npm run build -w @briefs/cli && npm run build -w @briefs/docs && npm run build -w @briefs/daily",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @briefs/system",
    "db:up": "docker compose -f docker/docker-compose.yml up -d postgres",
    "db:down": "docker compose -f docker/docker-compose.yml down",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d --build",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f system",
    "bootstrap:secrets": "bash scripts/bootstrap-secrets.sh",
    "deploy": "bash deploy.sh",
    "remote:status": "bash remote-cmd.sh status",
    "remote:logs": "bash remote-cmd.sh logs",
    "remote:restart": "bash remote-cmd.sh restart",
    "remote:stop": "bash remote-cmd.sh stop",
    "remote:start": "bash remote-cmd.sh start",
    "remote:shell": "bash remote-cmd.sh shell"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
