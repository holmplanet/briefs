{
  "name": "@briefs/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./actor": {
      "types": "./src/actor/index.ts",
      "default": "./dist/actor/index.js"
    },
    "./activity": {
      "types": "./src/activity/index.ts",
      "default": "./dist/activity/index.js"
    },
    "./item": {
      "types": "./src/item/index.ts",
      "default": "./dist/item/index.js"
    },
    "./question-flow": {
      "types": "./src/question-flow.ts",
      "default": "./dist/question-flow.js"
    },
    "./brief": {
      "types": "./src/brief/index.ts",
      "default": "./dist/brief/index.js"
    },
    "./auth": {
      "types": "./src/auth.ts",
      "default": "./dist/auth.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "echo \"(no tests yet)\" && exit 0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
