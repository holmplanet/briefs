{
  "name": "@briefs/system",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./src/runtime.ts",
      "default": "./dist/runtime.js"
    },
    "./web": {
      "types": "./src/web.ts",
      "default": "./dist/web.js"
    },
    "./web-oauth": {
      "types": "./src/web-oauth.ts",
      "default": "./dist/web-oauth.js"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "npm run build -w @briefs/shared && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:dev": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build -w @briefs/shared && vitest run"
  },
  "dependencies": {
    "@briefs/shared": "*",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
